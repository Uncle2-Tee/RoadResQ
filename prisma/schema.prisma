generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String               @id(map: "User_pkey") @default(cuid())
  name                   String
  email                  String               @unique(map: "User_email_key")
  phoneNumber            String
  role                   String
  passwordHash           String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  profilePhotoUri        String?
  activeSessionId        String?              @unique(map: "User_activeSessionId_key")
  activeSessionStartedAt DateTime?
  mechanicShops          MechanicShop[]       @relation("MechanicShopOwner")
  passwordResetTokens    PasswordResetToken[]
  driverPayments         Payment[]            @relation("DriverPayments")
  mechanicPayments       Payment[]            @relation("MechanicPayments")
  pushTokens             PushToken[]
  driverRequests         RequestHistory[]     @relation("DriverRequests")
  mechanicRequests       RequestHistory[]     @relation("MechanicRequests")
  towShops               TowShop[]            @relation("TowShopOwner")
  driverReviews          ProviderReview[]     @relation("DriverReviews")
  driverLocationTracks   DriverLocationTrack[] @relation("DriverLocationTracks")
  providerLocationTracks ProviderLocationTrack[] @relation("ProviderLocationTracks")

  @@map("Users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique
  platform   String?
  role       String?
  userId     String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@index([lastSeenAt])
}

model RequestHistory {
  id                 String        @id @default(cuid())
  requestId          String        @unique
  type               RequestType
  status             RequestStatus @default(PENDING)
  driverId           String?
  driverName         String
  driverPhone        String?
  driverLocation     String?
  mechanicId         String?
  providerName       String
  providerPhone      String?
  problemDescription String?
  price              Decimal?      @db.Decimal(10, 2)
  currency           String        @default("GHS")
  estimatedTime      Int?
  acceptedBy         String?
  requestedAt        DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  driver             User?         @relation("DriverRequests", fields: [driverId], references: [id])
  mechanic           User?         @relation("MechanicRequests", fields: [mechanicId], references: [id])

  @@index([driverId])
  @@index([mechanicId])
  @@index([type])
  @@index([status])
  @@index([requestedAt])
}

model MechanicShop {
  id                     String   @id(map: "MechanicShop_pkey") @default(cuid())
  shopId                 String   @unique(map: "MechanicShop_shopId_key")
  mechanicId             String?
  shopName               String
  phone                  String
  location               String
  specialization         String
  licenseNumber          String   @unique(map: "MechanicShop_licenseNumber_key")
  latitude               Decimal  @db.Decimal(10, 7)
  longitude              Decimal  @db.Decimal(10, 7)
  status                 String   @default("active")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  bankName               String?
  bankCode               String?
  accountNumber          String?
  accountName            String?
  paystackSubaccountCode String?
  approvalStatus         String   @default("approved")
  mechanic               User?    @relation("MechanicShopOwner", fields: [mechanicId], references: [id], map: "MechanicShop_mechanicId_fkey")
  providerReviews        ProviderReview[] @relation("MechanicShopReviews")

  @@index([mechanicId])
  @@index([status])
  @@index([latitude, longitude])
  @@index([latitude, longitude], map: "MechanicShop_latitude_longitude_idx")
  @@index([mechanicId], map: "MechanicShop_mechanicId_idx")
  @@index([status], map: "MechanicShop_status_idx")
  @@index([latitude, longitude], map: "Mechanic_TowShop_latitude_longitude_idx")
  @@index([mechanicId], map: "Mechanic_TowShop_mechanicId_idx")
  @@index([status], map: "Mechanic_TowShop_status_idx")
  @@map("MechanicShops")
}

model TowShop {
  id                     String   @id @default(cuid())
  shopId                 String   @unique
  mechanicId             String?
  shopName               String
  phone                  String
  location               String
  specialization         String
  licenseNumber          String   @unique
  latitude               Decimal  @db.Decimal(10, 7)
  longitude              Decimal  @db.Decimal(10, 7)
  status                 String   @default("active")
  approvalStatus         String   @default("approved")
  bankName               String?
  bankCode               String?
  accountNumber          String?
  accountName            String?
  paystackSubaccountCode String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
  mechanic               User?    @relation("TowShopOwner", fields: [mechanicId], references: [id])
  providerReviews        ProviderReview[] @relation("TowShopReviews")

  @@index([mechanicId])
  @@index([status])
  @@index([latitude, longitude])
  @@map("TowShops")
}

model Payment {
  id               String        @id @default(cuid())
  paymentId        String        @unique
  reference        String?       @unique
  method           PaymentMethod
  phoneNumber      String?
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("GHS")
  status           PaymentStatus @default(PROCESSING)
  driverId         String?
  driverName       String
  mechanicId       String?
  mechanicName     String?
  providerName     String?
  requestId        String?
  provider         String?
  paymentUrl       String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  platformFee      Decimal?      @db.Decimal(10, 2)
  commissionAmount Decimal?      @db.Decimal(10, 2)
  mechanicAmount   Decimal?      @db.Decimal(10, 2)
  releaseStatus    String        @default("pending")
  releasedAt       DateTime?
  releaseNote      String?
  driver           User?         @relation("DriverPayments", fields: [driverId], references: [id])
  mechanic         User?         @relation("MechanicPayments", fields: [mechanicId], references: [id])

  @@index([driverId])
  @@index([mechanicId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([requestId])
  @@index([releaseStatus])
}

model ProviderReview {
  id            String       @id @default(cuid())
  driverId      String
  providerType  ProviderType
  providerId    String
  mechanicShopId String?
  towShopId     String?
  rating        Int
  reviewText    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  driver        User         @relation("DriverReviews", fields: [driverId], references: [id], onDelete: Cascade)
  mechanicShop  MechanicShop? @relation("MechanicShopReviews", fields: [mechanicShopId], references: [id], onDelete: SetNull)
  towShop       TowShop?     @relation("TowShopReviews", fields: [towShopId], references: [id], onDelete: SetNull)

  @@unique([driverId, providerType, providerId])
  @@index([driverId])
  @@index([providerType, providerId])
  @@index([mechanicShopId])
  @@index([towShopId])
  @@map("ProviderReviews")
}

model DriverLocationTrack {
  id         String   @id @default(cuid())
  driverId   String
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracy   Decimal? @db.Decimal(10, 2)
  source     String   @default("gps")
  recordedAt DateTime @default(now())
  driver     User     @relation("DriverLocationTracks", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt])
  @@map("DriverLocationTracks")
}

model ProviderLocationTrack {
  id         String   @id @default(cuid())
  providerId String
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracy   Decimal? @db.Decimal(10, 2)
  recordedAt DateTime @default(now())
  provider   User     @relation("ProviderLocationTracks", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, recordedAt])
  @@map("ProviderLocationTracks")
}

enum RequestType {
  SERVICE
  TOW
  CALL
  SMS
  CHAT
  EMERGENCY
}

enum RequestStatus {
  PENDING
  CONFIRMED
  ACCEPTED
  DECLINED
  CANCELLED
  CALLED
  MESSAGED
  CHAT
}

enum PaymentMethod {
  MTN
  TELECEL
  AIRTEL
  PAYSTACK
  CARD
  MOBILE_MONEY
}

enum PaymentStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderType {
  MECHANIC
  TOW
}
